<td>
  <div class="is-several">
    <%= image_tag model.logo.variant(resize_to_limit: [32, 32]), class: 'image is-radius is-32x32' if model.logo.attached? %>
    <span><%= model.name %></span>
  </div>
  <p class="text-grey"><%= model.note %></p>
</td>
<td><%= model.appid %></td>
<td class="family-monospace"><%= model.key %></td>
<td><%= model.host %></td>
<td>
  <%= form_with theme: 'switch', model: model, url: { action: 'update', id: model.id }, data: { controller: 'input' } do |f| %>
    <%= f.checkbox :enabled, data: { action: 'input#submit' }, id: nil %>
  <% end %>
</td>
