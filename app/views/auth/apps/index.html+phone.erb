<%= render 'filter_bar' %>

<% if @app_views.present? %>
<div class="card as-transparent">
  <div class="card-header">
    <span class="size-7 text-grey has-border-left-primary">最近使用</span>
  </div>
  <div class="card-content fixed-grid has-4-cols">
    <div id="view_container" class="grid">
      <%= render partial: 'app_view', collection: @app_views, as: :model %>
    </div>
  </div>
</div>
<% end %> 

<% if @all_apps.present? %>
<div class="card as-transparent">
  <div class="card-header">
    <span class="size-7 text-grey has-border-left-primary">我的收藏</span>
  </div>
  <div class="card-content fixed-grid has-4-cols">
    <div id="star_container" class="grid">
      <%= render partial: 'app_view', collection: @all_apps, as: :model %>
    </div>
  </div>
</div>
<% end %>

<div class="card">
  <div class="card-image">
    <%= image_tag 'banners/head.jpg', class: 'image' %>
  </div>
  <div class="card-content p-0">
    <%= render partial: 'app_media', collection: @apps, as: :model %>
  </div>
</div>
