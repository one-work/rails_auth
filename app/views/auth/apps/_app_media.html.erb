<div class="media">
  <div class="media-left">
  <% if model.logo.attached? %>
    <%= image_tag model.logo.variant(resize_to_limit: [64, 64]), class: 'image is-64x64' %>
  <% else %>
    <%= image_tag 'logo_organ.png', class: 'image is-64x64' %>
  <% end %>
  </div>
  <div class="media-content">
    <h2 class="title is-6"><%= model.name %></h2>
    <p class="size-7 text-grey"><%= model.note %></p>
  </div>
  <div class="media-right">
    <%= link_to model.url, data: { turbo: false }, class: 'button is-rounded is-small is-light' do %>
      <span>打开</span>
    <% end %>
  </div>
</div>
